{
    "manifest_version": 3,
    "name": "Cyber Guardian Plugin",
    "version": "1.0",
    "description": "Detects phishing links on web pages",
    "permissions": ["activeTab", "scripting"],
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["plugin.js"],
        "css": []
      }
    ],
    "web_accessible_resources": [
      {
        "resources": [],
        "matches": ["<all_urls>"]
      }
    ]
  }